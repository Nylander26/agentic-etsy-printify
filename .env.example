# Google Gemini — obtener en https://ai.google.dev (Google AI Studio)
GEMINI_API_KEY=

# Printify — obtener en https://printify.com/app/account/api
PRINTIFY_API_TOKEN=

# Apify — scraper-as-a-service para señales de marketplace en Etsy (research).
# Token: https://console.apify.com/account/integrations
# Default actor: automation-lab~etsy-scraper (https://apify.com/automation-lab/etsy-scraper)
APIFY_TOKEN=
APIFY_ETSY_ACTOR_ID=

# Telegram — para notificaciones cuando hay diseños listos para revisar
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
